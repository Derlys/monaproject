{
  "name": "monpago-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API + indexador de eventos para MonPago Colombia (Monad Testnet)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
