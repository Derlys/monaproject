# ---------- Servidor ----------
PORT=4000
# Dominios del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:3000

# ---------- Modo ----------
# true = datos falsos en memoria (no necesita Supabase ni contrato). Útil para destrabar al frontend.
USE_MOCK=true

# ---------- Monad Testnet ----------
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
EXPLORER_URL=https://testnet.monadvision.com

# ---------- Contrato MonPago (llenar tras el despliegue) ----------
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Bloque en el que se desplegó el contrato (el indexador empieza aquí)
DEPLOY_BLOCK=0

# ---------- Indexador ----------
# Rango máximo de bloques por getLogs (el RPC público de Monad limita el rango)
LOG_CHUNK_SIZE=100
POLL_INTERVAL_MS=2000
# Bloques de margen respecto a la punta de la cadena
CONFIRMATIONS=1

# ---------- Supabase (solo si USE_MOCK=false) ----------
SUPABASE_URL=
# Service role key: NUNCA en el frontend, NUNCA en el repo
SUPABASE_SERVICE_ROLE_KEY=
